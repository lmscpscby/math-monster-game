/* Backup 2026-10-28 (HKT): previous #pokemon-battle-arena.neon-stage background
   (no image file — solid CSS gradient only). Restore by pasting into index.html. */
#pokemon-battle-arena.neon-stage {
    background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-mid) 52%, #12081f 100%);
    border-color: rgba(236, 72, 153, 0.55);
    box-shadow:
        0 0 0 1px rgba(191, 0, 255, 0.28),
        0 0 22px rgba(236, 72, 153, 0.32),
        0 14px 36px rgba(0, 0, 0, 0.5);
}
